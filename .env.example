# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Loaded by scripts/run_local.ps1 and scripts/run_local.sh

# --- GitHub (private repos / PR creation). Fine-grained PAT, see README section 5
# Several tokens: GIT_TOKEN, GIT_TOKEN2, GIT_TOKEN3 ... ; the Excel column Token_Name says which one a repository uses.
# Empty Token_Name = every configured token is tried in order until one has access.
GIT_TOKEN=
GIT_TOKEN2=
GITHUB_TOKEN=
# Set true to run everything WITHOUT sending e-mail and WITHOUT creating pull requests
DIU_TEST_MODE=true

# --- SMTP (only needed when e-mail is enabled)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=devops-automation@example.com
# Optional - only used when email.recipients_source: excel_plus_secrets. Normally recipients come from the Excel file.
EMAIL_TO=
EMAIL_CC=

# --- Optional: avoids Docker Hub anonymous rate limits
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# --- Optional run overrides (same names the workflow sets)
DIU_STRATEGY=same_major
DIU_DRY_RUN=true
DIU_REPOSITORIES=
DIU_EMAIL_ENABLED=false
